<!--pages/index/index.wxml-->
<view class="root-page">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">智能设备控制中心</text>
  </view>

  <!-- 顶部传感器 2×2方块【大小不变，左上温度/右上湿度/左下空气质量/右下柜门】 -->
  <view class="sensor-box">
    <view class="sensor-grid">
      <view class="sensor-card temp-card">
        <text class="sensor-label">当前温度</text>
        <text class="sensor-value">{{temp}} ℃</text>
      </view>
      <view class="sensor-card humi-card">
        <text class="sensor-label">当前湿度</text>
        <text class="sensor-value">{{humi}} %RH</text>
      </view>
      <view class="sensor-card air-card">
        <text class="sensor-label">空气质量</text>
        <text class="sensor-value {{airQualityClass}}">{{air_quality}}</text>
      </view>
      <view class="sensor-card door-card">
        <text class="sensor-label">柜门状态</text>
        <view class="status-wrap">
          <text class="sensor-value {{doorStatusClass}}">{{door_status}}</text>
          <text class="status-icon">{{door_status == '开启' ? '🔓' : '🔒'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 烤灯控制区 -->
  <view class="device-box roast-box">
    <view class="device-header">
      <text class="device-title">烤灯控制</text>
      <text class="device-tag">加热模块</text>
    </view>
    <view class="device-status">
      <text class="status-label">状态：</text>
      <text class="status-value {{roast_led_status == '运行中' ? 'status-running' : 'status-stop'}}">{{roast_led_status}}</text>
    </view>
    <view class="btn-group">
      <button bindtap="roastLedOn" class="btn open-btn" disabled="{{door_status == '开启' || roast_led_status == '运行中'}}">开启烤灯</button>
      <button bindtap="roastLedOff" class="btn close-btn" disabled="{{roast_led_status == '未运行'}}">关闭烤灯</button>
    </view>
  </view>

  <!-- 风扇控制区 -->
  <view class="device-box fan-box">
    <view class="device-header">
      <text class="device-title">风扇控制</text>
      <text class="device-tag">通风模块</text>
    </view>
    <view class="device-status">
      <text class="status-label">状态：</text>
      <text class="status-value {{fan_status == '运行中' ? 'status-running' : 'status-stop'}}">{{fan_status}}</text>
    </view>
    <view class="btn-group">
      <button bindtap="fanOn" class="btn open-btn" disabled="{{door_status == '开启' || fan_status == '运行中'}}">开启风扇</button>
      <button bindtap="fanOff" class="btn close-btn" disabled="{{fan_status == '未运行'}}">关闭风扇</button>
    </view>
  </view>

  <!-- 消毒灯控制区 -->
  <view class="device-box light-box">
    <view class="device-header">
      <text class="device-title">夜间灯控制</text>
      <text class="device-tag">消毒模块</text>
    </view>
    <view class="device-status">
      <text class="status-label">状态：</text>
      <text class="status-value {{night_led_status == '运行中' ? 'status-running' : 'status-stop'}}">{{night_led_status}}</text>
    </view>
    <view class="btn-group">
      <button bindtap="nightLedOn" class="btn open-btn" disabled="{{door_status == '开启' || night_led_status == '运行中'}}">手动开启</button>
      <button bindtap="nightLedOff" class="btn close-btn" disabled="{{night_led_status == '未运行'}}">手动关闭</button>
    </view>
  </view>
</view>